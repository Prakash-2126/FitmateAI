# ==========================================
# FitMate AI - Environment Variables Reference
# ==========================================
# When deploying to Vercel, add these variables in:
# Vercel Dashboard > Project Settings > Environment Variables

# --- MongoDB Database (Required) ---
# Use MongoDB Atlas cloud connection URI for production
# Example: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/fitmate_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/fitmate_ai?retryWrites=true&w=majority

# --- Application Secrets (Required in Production) ---
JWT_SECRET=generate_a_long_random_secret_string_for_jwt
JWT_EXPIRES_IN=7d
COOKIE_SECRET=generate_a_long_random_secret_string_for_cookies

# --- Client URL (Optional) ---
# When deployed together on Vercel, this is automatically handled
# CLIENT_URL=https://your-app-name.vercel.app

# --- AI Configuration (Optional) ---
# Supports Google Gemini for live AI fitness coach responses
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite

# --- Client-Side API Base URL (Optional) ---
# Leave unset when deploying both frontend and backend to the same Vercel project (defaults to /api)
# Set only if backend is hosted separately on Render, Railway, etc.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
